# Copy to .env and fill in your values.

# Domain for Caddy: it will issue the HTTPS certificate itself. Local: ":80".
SITE_ADDRESS=launcher.example.com

PORT=8081

# Where the database and modpack files go. objects/ and tmp/ appear inside.
# In docker this is /data (see docker-compose.yml); this value is for running
# without docker.
DATA_DIR=./data

# How this backend is reachable from outside. Manifest URLs and the Vedrow
# redirect URI are built from it, so it is required in production — and it must
# be a DOMAIN, not an IP: then moving to another server requires no changes
# here nor in Vedrow.
PUBLIC_BASE_URL=https://launcher.example.com

# Directory with the site's static files. Empty or missing: pure API mode.
WEB_DIR=./web

# Set these ONLY if the site lives separately from the backend: then the browser
# is sent back there after login and that origin is allowed in CORS. Empty means
# the backend serves the site itself, the redirect is relative and CORS is off.
# PUBLIC_WEB_URL=
# CORS_ORIGIN=

# --- Vedrow login ---
# Vedrow's API (token/userinfo) and its frontend (consent screen) are different
# addresses.
VEDROW_API_URL=https://vedrow.com/api
VEDROW_WEB_URL=https://vedrow.com
# From the Vedrow admin panel: create an application under Vedrow login, NOT public.
VEDROW_CLIENT_ID=
VEDROW_CLIENT_SECRET=
# The same address must be registered in the app as a redirect URI: Vedrow
# compares it exactly, no prefixes. Defaults to PUBLIC_BASE_URL + /auth/vedrow/callback.
# Vedrow only accepts https or loopback here — never a LAN address like
# 192.168.x.x. Running without a domain? Keep the callback on 127.0.0.1 and log
# in as admin from the server machine; the port is not compared for loopback.
# VEDROW_REDIRECT_URI=http://127.0.0.1:8081/auth/vedrow/callback

# Who is an admin of Pasyot: Vedrow usernames or emails, comma separated.
# Vedrow does not report a role — this one is ours, not its.
ADMINS=

# Cap for a single upload (modpack archive or launcher binary).
MAX_UPLOAD_MB=4096

# --- Where the launcher itself is downloaded from ---
# Three sources, first one set wins:
#   LAUNCHER_URL   /launcher/download answers 302 to this address (GitHub
#                  release, file hosting, another server)
#   LAUNCHER_FILE  path to a file on disk; the server sends it itself. In docker
#                  put the file into ./data and point here at /data/<name>
#   neither        the build uploaded via POST /launcher/builds is used
# While any of the first two is set, uploads answer 409.
# LAUNCHER_URL=https://github.com/you/pasyot-launcher/releases/latest/download/PasyotLauncher.exe
# LAUNCHER_FILE=/data/PasyotLauncher-0.1.0.exe
# Shown next to the download button; optional.
# LAUNCHER_VERSION=0.1.0
